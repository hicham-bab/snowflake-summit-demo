# Copy to .env and fill in your Snowflake account details.
# Load with: source .env  (or use direnv)

export SNOWFLAKE_ACCOUNT="your-account.snowflakecomputing.com"
export SNOWFLAKE_USER="dbt_atlas"
export SNOWFLAKE_PASSWORD="your_password"
export SNOWFLAKE_ROLE="TRANSFORMER"
export SNOWFLAKE_WAREHOUSE="ATLAS_WH"

# Per-database overrides (defaults shown — change if you use different names)
export SNOWFLAKE_DATABASE="ATLAS_PLATFORM"
export SNOWFLAKE_DATABASE_MKT="ATLAS_MARKETING"
export SNOWFLAKE_DATABASE_FIN="ATLAS_FINANCE"
